{
  "name": "ai-lms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI-Native Course Editor for Canvas",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:web": "node --experimental-strip-types --test tests/web/*.test.ts",
    "test:workspace-live": "RUN_WORKSPACE_LIVE_TESTS=1 node --env-file=.env --experimental-strip-types --test tests/web/workspaceAccess.live.ts",
    "check:supabase": "node --env-file=.env scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.6",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "10.4.23",
    "postcss": "8.5.19",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
