# Copy this file to `.env` and fill in your Supabase project values.
# Find these in the Supabase Dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# SUPABASE_SECRET_KEY=sb_secret_xxx   # server-only, never expose to the browser

# LOCAL DEVELOPMENT ONLY: Issue #4 temporarily disables RLS so this
# publishable key can seed and read fixture course content. Re-enable RLS and
# use authenticated ownership policies before any shared deployment.
