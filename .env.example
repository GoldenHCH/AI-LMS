# Copy this file to `.env` and fill in your Supabase project values.
# Find these in the Supabase Dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Temporary compatibility only; remove after all environments use the variable above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Shared credential and location for the request-local FastAPI sidecar.
# Generate a high-entropy value (at least 32 random bytes) and keep it server-only.
CANVAS_IMPORT_SERVICE_TOKEN=replace-with-a-high-entropy-server-secret
CANVAS_IMPORT_SERVICE_URL=http://127.0.0.1:8000

# Comma-separated exact self-hosted Canvas domains. *.instructure.com is allowed automatically.
CANVAS_ALLOWED_HOSTS=
