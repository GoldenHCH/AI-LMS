# VITE_DEMO_REQUEST_URL: HTTPS link opened by every "Request a Demo" control
# on the site (currently the team's Google Form). Required — `npm run build`
# fails if it is missing or not a valid HTTPS URL. Not required for `npm run
# dev` (CTAs just render as inert "#" links until you set it).
VITE_DEMO_REQUEST_URL="https://forms.gle/REPLACE_WITH_REAL_FORM_ID"
